# ---------------------------------------------------------------------------
# Base de dados — MySQL da Hostinger
# hPanel > Bases de dados > MySQL: criar base e utilizador, e usar aqui os dados.
# Dentro do alojamento o servidor é normalmente localhost.
# ---------------------------------------------------------------------------
DATABASE_URL=mysql://utilizador:password@localhost:3306/nome_da_base

# ---------------------------------------------------------------------------
# Código de instalação
# Pedido em /admin/setup para criar a primeira conta. Serve para ninguém poder
# reclamar o painel na janela entre o site ir para o ar e a sua primeira entrada.
# Pode ser qualquer frase à sua escolha. Deixa de ter efeito assim que existir
# uma conta criada.
# ---------------------------------------------------------------------------
SETUP_TOKEN=troque-esta-frase

# ---------------------------------------------------------------------------
# Pasta das imagens carregadas no painel
# TEM de ficar FORA da pasta do projecto, senão cada deploy apaga tudo.
# Na Hostinger costuma ser /home/uXXXXXXXXX/uploads
# Sem esta variável: ~/uploads em produção, ./uploads em desenvolvimento.
# ---------------------------------------------------------------------------
UPLOAD_DIR=/home/uXXXXXXXXX/uploads

# ---------------------------------------------------------------------------
# Email das mensagens de contacto — SMTP da Hostinger
# Usar a caixa de correio do domínio criada no hPanel.
# Sem isto o formulário continua a funcionar: as mensagens ficam no painel,
# apenas ninguém é avisado por email.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=geral@meteoro24.ao
SMTP_PASS=
SMTP_FROM=Site Meteoro 24 <geral@meteoro24.ao>

# Para onde seguem as mensagens do formulário
CONTACT_TO=geral@inovholding.com
