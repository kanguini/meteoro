# ---------------------------------------------------------------------------
# Base de dados (Supabase Postgres)
# Painel > Project Settings > Database > Connection string > URI
# Usar a ligação "Session pooler" ou "Transaction pooler" em produção.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres

# ---------------------------------------------------------------------------
# Armazenamento de imagens (Supabase Storage)
# Criar um bucket PÚBLICO chamado "meteoro".
# A service key é secreta: nunca a pôr em código do cliente nem no repositório.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=meteoro

# ---------------------------------------------------------------------------
# Envio de email das mensagens de contacto (opcional)
# Sem isto o formulário continua a funcionar: as mensagens ficam guardadas no
# painel, apenas ninguém é avisado por email.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
CONTACT_FROM=site@meteoro24.ao
CONTACT_TO=geral@inovholding.com
