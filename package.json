    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.12",
    "typescript": "5.7.2"
  },
  "engines": {
    "node": ">=20.9"
